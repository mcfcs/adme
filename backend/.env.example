# Copy this file to backend/.env and fill it in.

# Supabase Postgres connection string.
# Supabase dashboard -> your project -> "Connect" (top bar) -> "Transaction pooler" -> copy the URI,
# then replace [YOUR-PASSWORD] with your database password.
# Leave it EMPTY to use a local SQLite file (backend/local.db) for testing.
DATABASE_URL=

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Only needed if the frontend runs on a different domain than the API.
FRONTEND_URL=http://localhost:5173
